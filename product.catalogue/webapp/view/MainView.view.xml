<mvc:View controllerName="pc.product.catalogue.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="_IDGenPage" title="Catálogo de Productos">
        <headerContent>
            <SearchField id="searchProducts" placeholder="Search products..." liveChange=".onSearchProduct" search=".onSearchProduct" width="50%"/>
            <Button id="addProduct" icon="sap-icon://add-product" text="{i18n>mainView.button.addProductButton}" press=".onOpenDialog"/>
        </headerContent>
        <content>
            <List id="productList" items="{products>/items}"  noDataText="{i18n>mainView.search.noProducts}">
                <items>
                    <ObjectListItem id="productItem" title="{products>name}" intro="{products>description}" number="{products>price}" numberUnit="USD" icon="{products>image}" type="Active" press=".onListItemPress"/>
                </items>
            </List>
        </content>
    </Page>
</mvc:View>